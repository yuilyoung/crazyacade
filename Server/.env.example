PORT=8080
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
ALLOW_DEV_GUESTS=false
# Server-only completed results; mount this directory on persistent storage.
RESULT_OUTBOX_DIR=data/results
# Optional per-process admission and shutdown limits (these are defaults).
RUNTIME_MAX_CONNECTIONS=256
RUNTIME_MAX_ROOMS=64
RUNTIME_MAX_QUEUED_PLAYERS=128
RUNTIME_AUTH_CAPACITY=4
RUNTIME_AUTH_MAX_PENDING=32
RUNTIME_MESSAGE_RATE=30
RUNTIME_MESSAGE_BURST=60
RUNTIME_SEND_SOFT_BYTES=65536
RUNTIME_SEND_HARD_BYTES=262144
RUNTIME_SEND_MAX_DELAY_MS=3000
RUNTIME_DRAIN_MS=130000
